    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Interactive Client Reviews Store
        let clientReviews = [];

        let selectedRating = 5;

        // Render Reviews List
        function renderReviews() {
            const container = document.getElementById('feedback-grid');
            if (clientReviews.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-8 text-gray-500 text-sm">
                        No feedback posted yet. Be the first to post your experience above!
                    </div>
                `;
                return;
            }

            container.innerHTML = clientReviews.map(r => `
                <div class="p-6 rounded-2xl border border-gray-800 bg-dark-card space-y-4">
                    <div class="flex items-center text-amber-400 gap-1 text-sm">
                        ${Array(r.rating).fill('<i class="fa-solid fa-star"></i>').join('')}
                    </div>
                    <p class="text-gray-300 text-sm leading-relaxed">"${r.comment}"</p>
                    <div class="flex items-center justify-between border-t border-gray-800/80 pt-4">
                        <h5 class="text-white font-bold text-sm">${r.name}</h5>
                        <span class="text-gray-500 text-xs">${r.time}</span>
                    </div>
                </div>
            `).join('');
        }

        // Set Rating Stars
        function setRating(rating) {
            selectedRating = rating;
            const stars = document.querySelectorAll('#star-rating-select i');
            stars.forEach((star, index) => {
                if(index < rating) {
                    star.classList.add('text-amber-400');
                    star.classList.remove('text-gray-600');
                } else {
                    star.classList.remove('text-amber-400');
                    star.classList.add('text-gray-600');
                }
            });
        }

        // Handle Client Feedback Submit
        function handleFeedbackSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('fb-name').value;
            const comment = document.getElementById('fb-comment').value;

            clientReviews.unshift({
                name: name,
                rating: selectedRating,
                comment: comment,
                time: "Just now"
            });

            renderReviews();
            document.getElementById('feedback-form').reset();
            setRating(5);
        }

        // Initial setup on load
        window.addEventListener('DOMContentLoaded', () => {
            renderReviews();
            setRating(5);

            // Set minimum date to today
            const today = new Date().toISOString().split('T')[0];
            const dateInput = document.getElementById('modal-service-date');
            if (dateInput) dateInput.min = today;
        });

        // Mobile Nav Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Booking Modal State
        let currentPackageName = 'Standard';
        let currentPackageBasePrice = 100;
        let calcVehicleFee = 0;

        function openBookingModal(pkgName, basePrice) {
            currentPackageName = pkgName;
            currentPackageBasePrice = basePrice;

            document.getElementById('modal-pkg-name').textContent = pkgName + " Package";
            document.getElementById('modal-pkg-base-price').textContent = "R" + basePrice;

            const radios = document.getElementsByName('Vehicle_Type');
            radios[0].checked = true;

            const checkboxes = document.querySelectorAll('.modal-addon');
            checkboxes.forEach(cb => cb.checked = false);

            updateModalPrice();
            document.getElementById('booking-modal').classList.remove('hidden');
        }

        function closeBookingModal() {
            document.getElementById('booking-modal').classList.add('hidden');
        }

        function updateModalPrice() {
            let total = currentPackageBasePrice;

            const vehicleRadios = document.getElementsByName('Vehicle_Type');
            vehicleRadios.forEach(radio => {
                if (radio.checked) {
                    if (radio.value.includes('20')) total += 20;
                    if (radio.value.includes('40')) total += 40;
                }
            });
            updateVehicleCardStyles();

            const checkboxes = document.querySelectorAll('.modal-addon');
            checkboxes.forEach(cb => {
                if (cb.checked) {
                    if (cb.value.includes('50')) total += 50;
                    if (cb.value.includes('60')) total += 60;
                }
            });

            document.getElementById('modal-final-price').textContent = "R" + total;
            document.getElementById('hidden-pkg-input').value = currentPackageName;
            document.getElementById('hidden-total-input').value = "R" + total;
        }

        function updateVehicleCardStyles() {
            const cards = document.querySelectorAll('.modal-v-card');
            cards.forEach(card => {
                const radio = card.querySelector('input[type="radio"]');
                if (radio.checked) {
                    card.classList.add('border-brand-500', 'bg-brand-500/20');
                    card.classList.remove('border-gray-800', 'bg-gray-900');
                } else {
                    card.classList.remove('border-brand-500', 'bg-brand-500/20');
                    card.classList.add('border-gray-800', 'bg-gray-900');
                }
            });
        }

        // Automatic Mail Dispatch Handler
        function handleBookingSubmit(e) {
            const name = document.getElementById('modal-name').value;
            const phone = document.getElementById('modal-phone').value;
            const email = document.getElementById('modal-email').value;
            const date = document.getElementById('modal-service-date').value;
            const time = document.getElementById('modal-booking-time').value;
            const price = document.getElementById('modal-final-price').textContent;

            // Trigger mailto fallback to guarantee arrival at marnusvs09@gmail.com
            const mailtoSubject = encodeURIComponent(`New Booking: ${currentPackageName} Package - M.CarsClean`);
            const mailtoBody = encodeURIComponent(
                `Booking Request for M.CarsClean:\n\n` +
                `Name: ${name}\n` +
                `Phone: ${phone}\n` +
                `Email: ${email}\n` +
                `Package: ${currentPackageName}\n` +
                `Service Date: ${date}\n` +
                `Booking Time Slot: ${time}\n` +
                `Total Price: ${price}\n`
            );

            window.open(`mailto:marnusvs09@gmail.com?subject=${mailtoSubject}&body=${mailtoBody}`, '_blank');
            
            closeBookingModal();
            showToast();
        }

        function showToast() {
            const toast = document.getElementById('toast');
            toast.classList.remove('hidden', 'translate-y-4');
            setTimeout(() => {
                toast.classList.add('hidden', 'translate-y-4');
            }, 6000);
        }

        // Calculator Logic
        function setCalcVehicle(fee, btn) {
            calcVehicleFee = fee;
            const buttons = document.querySelectorAll('.calc-v-btn');
            buttons.forEach(b => {
                b.classList.remove('border-brand-500', 'bg-brand-500/20', 'text-white');
                b.classList.add('border-gray-800', 'bg-gray-900', 'text-gray-400');
            });
            btn.classList.remove('border-gray-800', 'bg-gray-900', 'text-gray-400');
            btn.classList.add('border-brand-500', 'bg-brand-500/20', 'text-white');
            updateCalc();
        }

        function updateCalc() {
            const pkgSelect = document.getElementById('calc-package');
            const basePrice = parseInt(pkgSelect.value);
            const pkgText = pkgSelect.options[pkgSelect.selectedIndex].text;

            let addonsTotal = 0;
            const checkboxes = document.querySelectorAll('.calc-addon');
            checkboxes.forEach(cb => {
                if (cb.checked) {
                    addonsTotal += parseInt(cb.value);
                }
            });

            const grandTotal = basePrice + calcVehicleFee + addonsTotal;

            document.getElementById('calc-total').textContent = "R" + grandTotal;
            document.getElementById('calc-summary-pkg').textContent = pkgText;
            document.getElementById('calc-summary-veh').textContent = "R" + calcVehicleFee;
            document.getElementById('calc-summary-add').textContent = "R" + addonsTotal;
        }

        function bookCalculatedQuote() {
            const pkgSelect = document.getElementById('calc-package');
            const basePrice = parseInt(pkgSelect.value);
            let pkgName = "Basic";
            if(basePrice === 100) pkgName = "Standard";
            if(basePrice === 270) pkgName = "Executive";

            openBookingModal(pkgName, basePrice);
        }
    </script>
